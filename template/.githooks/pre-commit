#!/usr/bin/env sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

BEFORE_STATUS="$(git status --porcelain)"

# Skip heavy checks when only docs/config files are staged (no Go/proto changes).
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
CODE_FILES="$(echo "$STAGED_FILES" | grep -E '\.(go|proto|sum|mod)$' || true)"

if [ -z "$CODE_FILES" ]; then
  echo "[pre-commit] docs-only change, skipping build/test gate."
  exit 0
fi

echo "[pre-commit] running commit gate checks..."
make check-commit

AFTER_STATUS="$(git status --porcelain)"
if [ "$BEFORE_STATUS" != "$AFTER_STATUS" ]; then
  echo "[pre-commit] working tree changed during checks. stage updated files and commit again."
  git status --short
  exit 1
fi
